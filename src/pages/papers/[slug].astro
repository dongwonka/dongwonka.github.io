---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AuthorList from '../../components/AuthorList.astro';
import BibtexCitation from '../../components/BibtexCitation.astro';
import Tag from '../../components/Tag.astro';

export async function getStaticPaths() {
  const papers = await getCollection('papers');
  return papers.map((paper) => ({
    params: { slug: paper.slug },
    props: {
      paper: {
        ...paper.data,
        slug: paper.slug
      }
    }
  }));
}

const { paper } = Astro.props;
const base = import.meta.env.BASE_URL;
const paperImage = `${base}${paper.image.replace(/^\//, '')}`;
const paperUrl = typeof paper.paperUrl === 'string' ? paper.paperUrl.trim() : '';
const hasPaperUrl = paper.paperStatus !== 'comingSoon' && /^https?:\/\/\S+$/i.test(paperUrl);
const citations = import.meta.glob<string>('../../../public/bibtex/*.bib', {
  query: '?raw',
  import: 'default',
  eager: true
});
const citation = paper.bibtexUrl
  ? citations[`../../../public${paper.bibtexUrl}`]?.trim()
  : undefined;
if (paper.bibtexUrl && !citation) {
  throw new Error(`Missing BibTeX citation for ${paper.slug}: ${paper.bibtexUrl}`);
}
const formatPublicationDate = (value: string) => {
  const [year, month, day] = value.split('-').map(Number);
  return new Date(Date.UTC(year, (month ?? 1) - 1, day ?? 1)).toLocaleDateString('en', {
    year: 'numeric',
    ...(month ? { month: 'long' as const } : {}),
    ...(day ? { day: 'numeric' as const } : {}),
    timeZone: 'UTC'
  });
};
const date = new Date(`${paper.acceptedDate}T00:00:00`);
const displayDate = date.toLocaleDateString('en', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
const displayPublishedOnline = paper.publishedOnline
  ? new Date(`${paper.publishedOnline}T00:00:00`).toLocaleDateString('en', {
      year: 'numeric',
      month: 'long',
      day: 'numeric'
    })
  : '';
---

<BaseLayout title={`${paper.title} | Dong Wang`} description={paper.summary}>
  <a
    href={base}
    class="mb-8 inline-flex items-center rounded-md border border-slate-200 bg-white px-3 py-2 text-sm font-medium text-slate-700 shadow-sm hover:border-sky-300 hover:text-sky-700"
  >
    Back to Home
  </a>

  <article class="space-y-7">
    <header class="space-y-4 border-b border-slate-200 pb-7">
      <h1 class="max-w-4xl text-3xl font-semibold leading-tight text-slate-950 sm:text-4xl">
        {paper.title}
      </h1>

      <AuthorList authors={paper.authors} class="text-base leading-7 text-slate-700" />

      <div class="flex flex-wrap gap-2">
        {paper.fieldTags.map((tag) => <Tag label={tag} type="field" />)}
        {paper.levelTags.map((tag) => <Tag label={tag} type="level" />)}
      </div>
    </header>

    <section class="grid gap-5 rounded-md border border-slate-200 bg-white p-5 shadow-sm sm:grid-cols-2">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">
          {paper.paperStatus === 'comingSoon' ? 'Accepted By' : 'Published In'}
        </p>
        <p class="mt-1 text-sm font-medium text-slate-900">{paper.venue}</p>
      </div>
      <div>
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Accepted Date</p>
        <p class="mt-1 text-sm font-medium text-slate-900">{displayDate}</p>
      </div>
      <div>
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Venue Type</p>
        <p class="mt-1 text-sm font-medium text-slate-900">{paper.venueType}</p>
      </div>
      <div>
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Venue Level</p>
        <p class="mt-1 text-sm font-medium text-slate-900">{paper.venueLevel}</p>
      </div>
      {displayPublishedOnline && (
        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Published Online</p>
          <p class="mt-1 text-sm font-medium text-slate-900">
            <time datetime={paper.publishedOnline}>{displayPublishedOnline}</time>
          </p>
        </div>
      )}
      {paper.publicationDate && (
        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Publication Date</p>
          <p class="mt-1 text-sm font-medium text-slate-900">
            <time datetime={paper.publicationDate}>{formatPublicationDate(paper.publicationDate)}</time>
          </p>
        </div>
      )}
      {paper.volume && (
        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Volume</p>
          <p class="mt-1 text-sm font-medium text-slate-900">{paper.volume}</p>
        </div>
      )}
      {paper.issue && (
        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Issue</p>
          <p class="mt-1 text-sm font-medium text-slate-900">{paper.issue}</p>
        </div>
      )}
      {paper.pages && (
        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Pages</p>
          <p class="mt-1 text-sm font-medium text-slate-900">{paper.pages}</p>
        </div>
      )}
      {paper.articleNumber && (
        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Article Number</p>
          <p class="mt-1 text-sm font-medium text-slate-900">{paper.articleNumber}</p>
        </div>
      )}
      {paper.doi && (
        <div class="sm:col-span-2">
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">DOI</p>
          <a
            href={`https://doi.org/${paper.doi}`}
            target="_blank"
            rel="noreferrer"
            class="mt-1 inline-block break-all text-sm font-medium text-slate-900 underline decoration-slate-300 underline-offset-2 hover:text-sky-700"
          >
            {paper.doi}
          </a>
        </div>
      )}
    </section>

    <img
      src={paperImage}
      alt={`${paper.title} teaser`}
      class="w-full rounded-md border border-slate-200 bg-white object-cover shadow-sm"
      loading="eager"
    />

    <section class="space-y-3">
      <h2 class="text-xl font-semibold text-slate-950">Abstract</h2>
      <p class="max-w-4xl text-base leading-8 text-slate-700">{paper.abstract}</p>
    </section>

    {
      hasPaperUrl ? (
        <div class="flex flex-wrap gap-3">
          <a
            href={paperUrl}
            target="_blank"
            rel="noreferrer"
            class="inline-flex rounded-md bg-slate-950 px-4 py-2.5 text-sm font-semibold text-white hover:bg-slate-800"
          >
            View Paper
          </a>
          {paper.pdfUrl && (
            <a
              href={paper.pdfUrl}
              target="_blank"
              rel="noreferrer"
              class="inline-flex rounded-md border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 hover:border-sky-300 hover:text-sky-700"
            >
              {paper.pdfAccess === 'subscription' ? 'PDF via Publisher' : 'PDF'}
            </a>
          )}
          {paper.pdfUrl && paper.pdfAccess === 'subscription' && (
            <p class="basis-full text-sm leading-6 text-slate-500">
              PDF access is provided by the publisher and may require an institutional subscription or purchase.
            </p>
          )}
        </div>
      ) : (
        <p class="inline-flex rounded-md border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-600">
          Coming soon.
        </p>
      )
    }
    {citation && <BibtexCitation citation={citation} slug={paper.slug} />}
  </article>
</BaseLayout>
